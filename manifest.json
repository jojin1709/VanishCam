{
  "manifest_version": 3,
  "name": "VanishCam",
  "version": "0.1.0",
  "description": "Snap your fingers and vanish from your own video in Google Meet. You stay in the call.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["effect.js", "snapdetect.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
